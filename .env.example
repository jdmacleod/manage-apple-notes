# Copy to .env and fill in values for your chosen provider.
# .env is gitignored and blocked by the pre-commit hook.

# ── Anthropic (default) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local) ─────────────────────────────────────────────────────────
# Defaults to http://localhost:11434 if unset.
# Ollama: http://localhost:11434  (without /v1)
# llama.cpp: http://localhost:8080/v1  (with /v1 — both forms are accepted)
# OLLAMA_BASE_URL=http://localhost:11434
# Model to use; overrides llm.model in settings.local.yaml.
# Use Ollama tag format: llama3, mistral, phi3, gemma:7b, etc.
# OLLAMA_MODEL=llama3
