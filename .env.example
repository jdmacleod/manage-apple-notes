# Copy to .env and fill in values for your chosen provider.
# .env is gitignored and blocked by the pre-commit hook.

# ── Anthropic (default) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local or AWS EC2) ──────────────────────────────────────────────
# These vars apply when llm.provider is set to "ollama" in settings.local.yaml.
# OLLAMA_BASE_URL sets the connection URL; if unset, defaults to localhost:11434.
# Ollama: http://localhost:11434  (without /v1)
# llama.cpp: http://localhost:8080/v1  (with /v1 — both forms are accepted)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL overrides llm.model within Ollama (useful for quick model swaps).
# Use Ollama tag format: llama3, mistral, phi3, gemma:7b, etc.
# OLLAMA_MODEL=llama3
