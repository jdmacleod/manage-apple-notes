# Copy to .env and fill in values for your chosen provider.
# .env is gitignored and blocked by the pre-commit hook.

# ── Anthropic (default) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama — local (provider: "ollama") ───────────────────────────────────
# OLLAMA_BASE_URL sets the connection endpoint; defaults to http://localhost:11434 if unset.
# Ollama: http://localhost:11434  (without /v1)
# llama.cpp: http://localhost:8080/v1  (with /v1 — both forms are accepted)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL overrides llm.model (useful for quick swaps without editing settings).
# Use Ollama tag format: llama3, mistral, phi3, gemma:7b, etc.
# OLLAMA_MODEL=llama3

# ── Ollama on AWS EC2 (provider: "aws-ollama") ─────────────────────────────
# After deploying the EC2 stack (cd infra && cdk deploy) and starting the SSH tunnel,
# set OLLAMA_BASE_URL to the tunnel endpoint — same default as local Ollama:
# OLLAMA_BASE_URL=http://localhost:11434
#
# These vars are read by the CDK stack (infra/) and override settings.local.yaml values:
# AWS_SSH_KEY_PATH=~/.ssh/my-aws-key.pem   # path to EC2 private key (overrides aws.ssh_key_path)
# AWS_ALLOWED_CIDR=1.2.3.4/32              # deployer IP for SSH security group (auto-detected if unset)
